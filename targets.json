{
  "exclusions_default": [
    "opencode"
  ],
  "targets": [
    {
      "id": "user_temp",
      "name": "User TEMP folder",
      "category": "os",
      "paths": [
        "%TEMP%"
      ],
      "requires_admin": false,
      "min_age_days": 1,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "system_temp",
      "name": "Windows system temp",
      "category": "system",
      "paths": [
        "%SYSTEMROOT%\\Temp"
      ],
      "requires_admin": true,
      "min_age_days": 1,
      "default_enabled": true,
      "danger": "low",
      "note": "Needs Administrator"
    },
    {
      "id": "windows_update",
      "name": "Windows Update downloads",
      "category": "system",
      "paths": [
        "%SYSTEMROOT%\\SoftwareDistribution\\Download"
      ],
      "requires_admin": true,
      "min_age_days": 1,
      "default_enabled": true,
      "danger": "low",
      "note": "Needs Administrator \u2014 safe, Windows re-downloads when needed"
    },
    {
      "id": "user_wer",
      "name": "Windows Error Reports (user)",
      "category": "os",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Windows\\WER"
      ],
      "requires_admin": false,
      "min_age_days": 7,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "system_wer",
      "name": "Windows Error Reports (all users)",
      "category": "system",
      "paths": [
        "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportQueue",
        "%PROGRAMDATA%\\Microsoft\\Windows\\WER\\ReportArchive"
      ],
      "requires_admin": true,
      "min_age_days": 7,
      "default_enabled": true,
      "danger": "low",
      "note": "Needs Administrator"
    },
    {
      "id": "inet_cache",
      "name": "Windows web cache (INetCache)",
      "category": "os",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache"
      ],
      "requires_admin": false,
      "min_age_days": 7,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "crash_dumps",
      "name": "Application crash dumps",
      "category": "os",
      "paths": [
        "%LOCALAPPDATA%\\CrashDumps"
      ],
      "requires_admin": false,
      "min_age_days": 7,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "pip_cache",
      "name": "pip cache",
      "category": "python",
      "paths": [
        "%LOCALAPPDATA%\\pip\\cache",
        "~\\.cache\\pip"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "uv_cache",
      "name": "uv cache",
      "category": "python",
      "paths": [
        "%LOCALAPPDATA%\\uv\\cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "poetry_cache",
      "name": "Poetry cache",
      "category": "python",
      "paths": [
        "%LOCALAPPDATA%\\pypoetry\\Cache",
        "%LOCALAPPDATA%\\pypoetry\\cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "npm_cache",
      "name": "npm cache",
      "category": "node",
      "paths": [
        "%LOCALAPPDATA%\\npm-cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "npm_legacy",
      "name": "npm legacy cache & logs",
      "category": "node",
      "paths": [
        "~\\.npm"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "yarn_cache",
      "name": "Yarn cache",
      "category": "node",
      "paths": [
        "%LOCALAPPDATA%\\Yarn\\Cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "pnpm_cache",
      "name": "pnpm cache & logs",
      "category": "node",
      "paths": [
        "%LOCALAPPDATA%\\pnpm-cache",
        "%LOCALAPPDATA%\\pnpm\\State",
        "%LOCALAPPDATA%\\pnpm\\_logs"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "electron_cache",
      "name": "Electron download cache",
      "category": "node",
      "paths": [
        "%LOCALAPPDATA%\\electron\\Cache",
        "%LOCALAPPDATA%\\electron-builder\\Cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "cypress_cache",
      "name": "Cypress binary cache",
      "category": "node",
      "paths": [
        "%LOCALAPPDATA%\\Cypress\\Cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "bun_cache",
      "name": "Bun package cache",
      "category": "node",
      "paths": [
        "~\\.bun\\install\\cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "playwright_browsers",
      "name": "Playwright browser binaries",
      "category": "node",
      "paths": [
        "%LOCALAPPDATA%\\ms-playwright"
      ],
      "requires_admin": false,
      "min_age_days": 30,
      "default_enabled": false,
      "danger": "med",
      "note": "Opt-in (--deep) \u2014 browsers re-download on next test run"
    },
    {
      "id": "nuget_http_cache",
      "name": "NuGet http cache (metadata)",
      "category": "dotnet",
      "paths": [
        "%LOCALAPPDATA%\\NuGet\\v3-cache"
      ],
      "requires_admin": false,
      "min_age_days": 0,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "nuget_packages",
      "name": "NuGet global package store",
      "category": "dotnet",
      "paths": [
        "~\\.nuget\\packages"
      ],
      "requires_admin": false,
      "min_age_days": 30,
      "default_enabled": false,
      "danger": "med",
      "keep_root": true,
      "note": "Opt-in (--deep) \u2014 full re-download cost"
    },
    {
      "id": "go_build_cache",
      "name": "Go build cache",
      "category": "golang",
      "paths": [
        "%LOCALAPPDATA%\\go-build"
      ],
      "requires_admin": false,
      "min_age_days": 7,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "cargo_cache",
      "name": "Cargo registry cache",
      "category": "rust",
      "paths": [
        "~\\.cargo\\registry\\cache"
      ],
      "requires_admin": false,
      "min_age_days": 30,
      "default_enabled": false,
      "danger": "med",
      "note": "Opt-in (--deep)"
    },
    {
      "id": "gradle_caches",
      "name": "Gradle caches",
      "category": "jvm",
      "paths": [
        "~\\.gradle\\caches"
      ],
      "requires_admin": false,
      "min_age_days": 30,
      "default_enabled": false,
      "danger": "med",
      "note": "Opt-in (--deep) \u2014 dependencies re-download (can be GBs, slow)"
    },
    {
      "id": "vscode_cache",
      "name": "VS Code caches & logs",
      "category": "editor",
      "paths": [
        "%APPDATA%\\Code\\Cache",
        "%APPDATA%\\Code\\CachedData",
        "%APPDATA%\\Code\\CachedExtensionVSIXs",
        "%APPDATA%\\Code\\logs",
        "%APPDATA%\\Code\\Service Worker\\CacheStorage",
        "%APPDATA%\\Code\\Code Cache"
      ],
      "requires_admin": false,
      "min_age_days": 1,
      "default_enabled": true,
      "danger": "low",
      "note": "Locked parts are skipped and reported if VS Code is running"
    },
    {
      "id": "vscode_insiders_cache",
      "name": "VS Code Insiders caches & logs",
      "category": "editor",
      "paths": [
        "%APPDATA%\\Code - Insiders\\Cache",
        "%APPDATA%\\Code - Insiders\\CachedData",
        "%APPDATA%\\Code - Insiders\\CachedExtensionVSIXs",
        "%APPDATA%\\Code - Insiders\\logs"
      ],
      "requires_admin": false,
      "min_age_days": 1,
      "default_enabled": true,
      "danger": "low"
    },
    {
      "id": "jetbrains_cache",
      "name": "JetBrains caches",
      "category": "editor",
      "paths": [
        "%LOCALAPPDATA%\\JetBrains"
      ],
      "requires_admin": false,
      "min_age_days": 7,
      "default_enabled": true,
      "danger": "med",
      "keep_root": true,
      "custom": "jetbrains",
      "note": "Deletes only product caches/index/LocalHistory subfolders; settings live in %APPDATA%\\JetBrains and are never touched"
    }
  ]
}